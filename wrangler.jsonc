// Cloudflare Workers yapılandırması (OpenNext adaptörü). Yayın adımları:
// docs/deploy-cloudflare.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare panelindeki Worker adıyla aynı olmalı (Workers Builds bunu kontrol eder).
  "name": "ahtapot-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  // nodejs_compat zorunlu; process.env'i (RESEND_API_KEY vb.) de doldurur.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext'in kendi kendine istek atması için; service = yukarıdaki name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ahtapot-web"
    }
  ],
  // next/image optimizasyonu. Ücretsiz planda ayda 5.000 benzersiz dönüşüm;
  // aşılırsa yeni dönüşümler hata verir, ücret çıkmaz.
  "images": {
    "binding": "IMAGES"
  },
  // İletişim formu hatalarını panelde görmek için (Workers Logs, ücretsiz planda var).
  "observability": {
    "enabled": true
  }
  // Ortam değişkenleri (RESEND_API_KEY, CONTACT_EMAIL_TO, CONTACT_EMAIL_FROM) burada
  // DEĞİL, panelde "Secret" olarak girilir: repo public, e-posta adresi buraya yazılmaz.
  // Secret'lar her deploy'da korunur.
  //
  // Özel alan adları (ahtapot.ink, www.ahtapot.ink) panelden bağlandı:
  // Worker → Domains. www → kök yönlendirmesi zone'daki Redirect Rule ile yapılır.
}
