# İletişim/talep formu — Resend ile mail gönderimi için gerekli.
# Bu değişkenler ayarlanmadan form gönderimi 500 (send_failed) döner
# (bkz. src/app/api/contact/route.ts, docs/mock-data-todo.md).

# Resend API anahtarı — https://resend.com/api-keys
RESEND_API_KEY=

# Talep e-postalarının gideceği gerçek kutu adresi
CONTACT_EMAIL_TO=

# Opsiyonel — verilmezse onboarding@resend.dev kullanılır (Resend'in test
# göndereni). Kendi alan adınız Resend'de doğrulanınca gerçek adresle
# değiştirin, ör: "Ahtapot <talep@ahtapot.com>"
CONTACT_EMAIL_FROM=
